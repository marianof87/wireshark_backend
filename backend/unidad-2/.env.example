# Puerto donde escucha el servidor.
PORT=3000

# URL de conexión SQLite gestionada por Prisma.
# El path es relativo a prisma/schema.prisma => prisma/dev.db
DATABASE_URL="file:./dev.db"

# En producción (u otro motor relacional) se puede apuntar a otro proveedor:
#   DATABASE_URL="postgresql://usuario:clave@localhost:5432/backend"
# y cambiar `provider` en prisma/schema.prisma a "postgresql".